# PostgreSQL connection string
DATABASE_URL="postgresql://ledgerly:ledgerly@localhost:5432/ledgerly?schema=public"

# Secret used to sign session tokens. Must be at least 32 characters — the app
# refuses to start otherwise. Generate one with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Only set this to "true" if you are deliberately serving the app over plain HTTP
# (e.g. testing a production build locally). It stops session cookies from being
# marked Secure, which is unsafe on the public internet — leave unset/false in
# any real deployment behind HTTPS.
# INSECURE_COOKIES="false"

# Allow anyone to create an account from /register (true/false)
ALLOW_SIGNUP="true"

# Initial admin created by `npm run db:seed`
SEED_ADMIN_EMAIL="admin@ledgerly.local"
SEED_ADMIN_PASSWORD="Admin@12345"

# Optional: "Sign in with Google". Leave both blank to hide the Google button entirely.
# Create these in Google Cloud Console > APIs & Services > Credentials > OAuth client ID
# (Web application), with an authorized redirect URI of:
#   <your app's URL>/api/auth/google/callback
# e.g. http://localhost:3000/api/auth/google/callback for local dev.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
